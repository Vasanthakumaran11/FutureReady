# ==========================================
# FutureReady — Comprehensive .gitignore
# ==========================================

# ------------------------------------------
# Environment & Secrets (Never commit credentials)
# ------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
.dev.vars
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
credentials.json
secrets.json
serviceAccountKey*.json
service_account*.json

# ------------------------------------------
# Python & FastAPI Backend
# ------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
venv/
.venv/
.env/
ENV/
backend/venv/
backend/.venv/
backend/env/
env.bak/
venv.bak/

# Distribution / Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Local databases & storage
*.db
*.sqlite
*.sqlite3
*.log

# ------------------------------------------
# Node.js & React / Vite Frontend
# ------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
.output/
frontend/.output/
.vinxi/
frontend/.vinxi/
.tanstack/
frontend/.tanstack/
.nitro/
frontend/.nitro/
.vite/
frontend/.vite/

# Local configuration overrides
*.local

# Wrangler / Cloudflare
.wrangler/

# ------------------------------------------
# Operating System & IDEs
# ------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# Visual Studio Code & JetBrains
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
